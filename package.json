{
  "name": "polya-solver",
  "version": "0.1.0",
  "description": "基于波利亚四阶段解题法的交互式数学辅导 Web 应用：选中解题步骤即可解释、追问、验证、可视化、生成同类练习。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-media.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/copy-media.mjs && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "lint": "eslint client server engines shared --ext ts,tsx",
    "test:corner": "node scripts/test-corner-cases.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:symbolic": "tsx scripts/test-symbolic.mjs",
    "import:cursor": "node scripts/import-cursor-settings.mjs"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "sql.js": "^1.14.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.35",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "katex": "^0.16.9",
    "marked": "^12.0.0",
    "mathjs": "^15.2.0",
    "mermaid": "^10.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  }
}
