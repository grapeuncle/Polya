# Polya 服务端配置
# 引擎：mock | openai | anthropic | deepseek
POLYA_ENGINE=deepseek
# API 密钥（也可用环境变量 DEEPSEEK_API_KEY）
POLYA_API_KEY=

POLYA_OPENAI_BASE_URL=https://api.openai.com/v1
POLYA_OPENAI_MODEL=gpt-4o-mini

POLYA_ANTHROPIC_BASE_URL=https://api.anthropic.com
POLYA_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

POLYA_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
POLYA_DEEPSEEK_MODEL=deepseek-chat

PORT=3001
